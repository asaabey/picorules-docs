  .language-introduction .eyebrow { color: var(--accent); margin-bottom: 1.6rem; }
  h2 { font-size: clamp(2.5rem, 3.65vw, 3.6rem); letter-spacing: -.035em; line-height: 1.08; }
  .language-introduction > p { font-size: .87rem; line-height: 1.9; color: var(--muted); max-width: 400px; }
  .comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.6rem; }
  .code-panel { min-width: 0; border-block: 1px solid var(--line); padding-block: 1.25rem; }
  .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: 1.3rem; color: var(--muted); }
  .panel-heading .eyebrow { font-size: .62rem; }
  .panel-heading > span:last-child { font-size: .65rem; }
  pre { margin: 0; padding: 1.1rem; background: var(--surface); overflow-x: auto; line-height: 1.9; font-size: .73rem; tab-size: 2; }
  code { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; }
  .definition-note { padding: 2.5rem 1.1rem 1rem; }
  .definition-note h3 { font-size: 1.85rem; letter-spacing: -.025em; }
  .definition-note p { margin-top: .9rem; font-size: .82rem; color: var(--muted); line-height: 1.9; max-width: 360px; }
  .definition-note .text-link { font-size: .75rem; margin-top: 1rem; }
  .example-caption { margin-top: 1rem; font-size: .7rem; color: var(--muted); line-height: 1.8; max-width: 800px; }
  .compiled-output { margin-top: 1.25rem; }
  summary { cursor: pointer; font-size: .77rem; padding-block: .75rem; }
  summary span { color: var(--muted); font-size: .66rem; margin-left: .6rem; }
  .compiled-output pre { margin-top: .6rem; max-height: 30rem; }
  .compiled-output .text-link { margin-block: .75rem; font-size: .73rem; }
  .language-notes { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 3.5rem; margin-top: 3rem; }
  .language-notes h3 { font-size: 1.7rem; letter-spacing: -.025em; }
  .language-notes p { margin-top: .7rem; font-size: .8rem; color: var(--muted); line-height: 1.85; }
  .language-notes a { display: inline-block; font-size: .73rem; text-decoration: none; margin-top: .8rem; padding-block: .4rem; }
  .language-notes a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1100px) { .language-introduction { gap: 4rem; } .language-notes { gap: 2rem; } }
  @media (max-width: 800px) { .language { padding-bottom: 70px; } .language-introduction { gap: 3rem; } .comparison { gap: 1.5rem; } .panel-heading { align-items: start; flex-direction: column; gap: .4rem; } .language-notes { gap: 1.5rem; } }
  @media (max-width: 600px) { .language { padding-bottom: 58px; } .language-introduction, .comparison, .language-notes { grid-template-columns: 1fr; } .language-introduction { gap: 1.6rem; } h2 { font-size: 2.65rem; } .panel-heading { flex-direction: row; } .definition-panel { grid-row: 1; } .language-notes { gap: 1.8rem; } .definition-note { padding-top: 1.5rem; } .language-introduction .eyebrow { font-size: .59rem; } }
</style>
