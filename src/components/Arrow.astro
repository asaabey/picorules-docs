---
interface Props {
  diagonal?: boolean;
}

const { diagonal = false } = Astro.props;
---

<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {diagonal ? (
    <path d="M6 18 18 6M6 6h12v12" />
  ) : (
    <path d="M4 12h15m-6-6 6 6-6 6" />
  )}
</svg>

<style>
  svg { flex: none; stroke: currentColor; stroke-width: 1.5; }
</style>
