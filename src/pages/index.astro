---
import SiteLayout from '../layouts/SiteLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import Arrow from '../components/Arrow.astro';
import PhenotypeFigure from '../components/PhenotypeFigure.astro';
import PhenotypeBackdrop from '../components/PhenotypeBackdrop.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageExample from '../components/LanguageExample.astro';
import BrowserExample from '../components/BrowserExample.astro';
import StudioSection from '../components/StudioSection.astro';
import docs from '../data/docs.json';

const steps = [
  {
    number: '01',
    title: 'Start with the evidence.',
    text: 'Work with dated observations: measurements, diagnoses, and medications. Make explicit which facts matter, and when.',
  },
  {
    number: '02',
    title: 'Give each construct a definition.',
    text: 'Express a measurement summary, a temporal pattern, or a classification as a named, reusable piece of clinical knowledge.',
  },
  {
    number: '03',
    title: 'Compose a richer picture.',
    text: 'Bring those constructs together into a phenotype definition. Reuse its characteristics in registries, research, and clinical applications.',
  },
];

const platforms = [
  { name: 'FHIR', detail: 'R4 resources', description: 'Evaluate definitions against clinical records supplied by a FHIR adapter.', href: '/docs/fhir-integration/' },
  { name: 'openEHR', detail: 'Clinical repositories', description: 'Access observations in an openEHR repository through an AQL-based adapter.', href: '/docs/openehr-integration/' },
  { name: 'SQL', detail: 'Population-scale analysis', description: 'Compile definitions for PostgreSQL, SQL Server, and Oracle databases.', href: '/docs/architecture/' },
];

const packages = [
  { label: 'FHIR adapter', name: 'picorules-adapter-fhir' },
  { label: 'Synthetic data', name: 'picorules-compiler-js-eadv-mocker' },
  { label: 'Database manager', name: 'picorules-compiler-js-db-manager' },
];
---

<SiteLayout>
  <header class="site-header shell">
    <Wordmark />
    <nav aria-label="Main navigation">
      <a class="approach-link" href="#approach">The approach</a>
      <a href="/docs/introduction/"><span class="nav-docs-full">Documentation</span><span class="nav-docs-short">Docs</span></a>
      <a class="nav-studio" href="https://studio.picorules.com">Open Studio <Arrow diagonal /></a>
      <ThemeToggle />
    </nav>
  </header>

  <main id="main">
    <section class="hero shell" aria-labelledby="hero-heading">
      <PhenotypeBackdrop />
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span></span> A language for clinical knowledge</p>
        <h1 id="hero-heading">Clinical phenotypes,<br /><em>thoughtfully modelled.</em></h1>
        <p class="hero-description">
          Turn patient observations into meaningful clinical descriptions.
          Picorules gives you a small, expressive language to define,
          compose, and reuse clinical knowledge.
        </p>
        <div class="hero-actions">
          <a class="button" href="/docs/introduction/">Explore the language <Arrow /></a>
          <a class="quiet-link" href="#approach">Discover the approach <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Open source. Built from clinical practice.</p>
      </div>
      <div class="hero-figure"><PhenotypeFigure /></div>
    </section>

    <div class="intro-line shell">
      <span class="eyebrow">Observations → Constructs → Phenotypes</span>
      <p>Small definitions. Shared understanding.</p>
    </div>

    <section id="approach" class="approach shell" aria-labelledby="approach-heading">
      <div class="section-introduction">
        <p class="eyebrow">01 — The approach</p>
        <h2 id="approach-heading">Clinical knowledge,<br /><em>made explicit.</em></h2>
        <p>
          A phenotype is more than a label. It is a description of a patient,
          built from evidence and the definitions that give it meaning.
        </p>
        <p>
          Picorules makes those definitions visible: the observations they
          use, the history they consider, and the smaller constructs they
          bring together.
        </p>
        <a class="text-link" href="/docs/tutorial/">See how a ruleblock works <Arrow /></a>
      </div>
      <ol class="approach-steps">
        {steps.map((step) => (
          <li>
            <span class="step-number">{step.number}</span>
            <div><h3>{step.title}</h3><p>{step.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <LanguageExample />

    <section class="platforms" aria-labelledby="platforms-heading">
      <div class="shell">
        <div class="platforms-introduction">
          <div>
            <p class="eyebrow">03 — Across platforms</p>
            <h2 id="platforms-heading">One definition.<br /><em>Many settings.</em></h2>
          </div>
          <p>
            Keep your clinical definitions together while adapters handle
            the data source. Bring shared knowledge to a population registry
            or an individual patient application.
          </p>
        </div>
        <div class="platform-list">
          {platforms.map((platform) => (
            <a href={platform.href} class="platform">
              <div class="platform-name"><h3>{platform.name}</h3><Arrow diagonal /></div>
              <p class="eyebrow">{platform.detail}</p>
              <p class="platform-description">{platform.description}</p>
            </a>
          ))}
        </div>
        <details class="integration-notes">
          <summary>How the definitions connect to your data</summary>
          <div class="integration-details">
            <div><h3>Fetch what the rule needs.</h3><p>The FHIR adapter inspects ruleblocks to identify their data requirements and build targeted queries. Terminology mappings connect attributes to the source's codes.</p><a href="/docs/fhir-integration/#smart-fhir-fetching">Read about smart fetching →</a></div>
            <div><h3>Fit into the clinical workflow.</h3><p>The same requirements can generate CDS Hooks prefetch templates. SMART on FHIR applications can use the JavaScript evaluator after retrieving their records.</p><a href="/docs/fhir-integration/">Explore FHIR integration →</a></div>
            <div><h3>Keep the mappings explicit.</h3><p>The openEHR adapter uses AQL to retrieve observations. Each deployment supplies the coding, units, and dated values its definitions expect.</p><a href="/docs/openehr-integration/">Explore openEHR integration →</a></div>
          </div>
        </details>
      </div>
    </section>

    <section id="packages" class="sdk shell" aria-labelledby="sdk-heading">
      <div class="section-introduction">
        <p class="eyebrow">04 — The npm packages</p>
        <h2 id="sdk-heading">Build it into<br /><em>your application.</em></h2>
        <p>
          Bring your clinical definitions into the software you already build.
          Start with the compiler, then add adapters and tools as you need them.
        </p>
        <a class="text-link" href="/docs/ecosystem/">Explore the SDK <Arrow /></a>
      </div>
      <div class="sdk-packages">
        <div class="compiler-package">
          <p class="eyebrow">The compiler &amp; runtime</p>
          <a class="compiler-name" href="https://www.npmjs.com/package/picorules-compiler-js-core">
            <code>picorules-compiler-js-core</code><Arrow diagonal />
          </a>
          <p class="compiler-description">
            A JavaScript and TypeScript package for parsing ruleblocks,
            generating SQL, and evaluating definitions directly in your application.
          </p>
          <pre class="install-command" aria-label="Install the Picorules compiler"><code>npm install picorules-compiler-js-core</code></pre>
          <div class="compiler-links">
            <a class="text-link" href="https://www.npmjs.com/package/picorules-compiler-js-core">View on npm <Arrow diagonal /></a>
            <a class="text-link" href="https://github.com/asaabey/picorules-compiler-js-core">Source code <Arrow diagonal /></a>
          </div>
        </div>
        <div class="supporting-packages">
          <p class="eyebrow">Adapters &amp; tools, also on npm</p>
          <ul>
            {packages.map((pkg) => (
              <li><a href={`https://www.npmjs.com/package/${pkg.name}`} aria-label={`${pkg.label}: ${pkg.name} on npm`}>{pkg.label}<Arrow diagonal /></a></li>
            ))}
          </ul>
        </div>
        <BrowserExample />
      </div>
    </section>

    <StudioSection />

    <section id="origins" class="origins shell" aria-labelledby="origins-heading">
      <div><p class="eyebrow">From clinical practice</p><h2 id="origins-heading">An idea with<br /><em>roots in care.</em></h2></div>
      <div class="origins-description">
        <p>Picorules began in 2019 within Territory Kidney Care, where clinical calculations needed to run inside an Oracle database. The TypeScript compiler extends that foundation to other SQL databases and direct evaluation in JavaScript.</p>
        <details class="evidence"><summary>Origins, evidence, and open development</summary><p>Published TKC studies evaluate specific clinical algorithms. Compiler tests and adapter comparisons examine software behaviour and selected outputs. These are different kinds of evidence, which the project describes separately.</p><ul><li><a href="/docs/whitepaper/">Read the project whitepaper →</a></li><li><a href="https://link.springer.com/article/10.1186/s12882-022-02947-9">TKC clinical algorithm validation study ↗</a></li><li><a href="https://link.springer.com/article/10.1186/s12911-024-02471-w">TKC system development study ↗</a></li><li><a href="https://github.com/asaabey/picorules-compiler-js-core/tree/master/tests">Inspect the compiler tests ↗</a></li><li><a href="/docs/architecture/">Read about execution and adapters →</a></li></ul></details>
        <div class="origins-links"><a class="text-link" href="/docs/whitepaper/">Read the whitepaper <Arrow /></a><a class="text-link" href="/docs/developers/">Meet the contributors <Arrow /></a></div>
      </div>
    </section>

    <section class="invitation shell" aria-labelledby="invitation-heading">
      <div class="invitation-copy">
        <p class="eyebrow">Begin with a definition</p>
        <h2 id="invitation-heading">Give clinical knowledge<br /><em>a language.</em></h2>
        <p>Learn the ideas behind Picorules, or open the Studio and start exploring.</p>
        <div class="invitation-actions">
          <a class="button button-light" href="/docs/introduction/">Read the Picorules Book <Arrow /></a>
          <a class="text-link" href="https://studio.picorules.com">Open Studio <Arrow diagonal /></a>
        </div>
      </div>
      <div class="invitation-aside">
        <span class="aside-rule"></span>
        <p>From an observation<br />to a construct.<br />From a construct<br />to a clearer picture.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <div><Wordmark /><p>A small language for meaningful clinical definitions.</p></div>
    <div class="footer-links">
      <a href="/docs/introduction/">The Book</a>
      <a href="https://github.com/asaabey/picorules-compiler-js-core">GitHub <Arrow diagonal /></a>
      <a href="/docs/developers/">The people behind it</a>
      <a href="/references/picorules-language-reference.md">For AI agents <Arrow diagonal /></a>
    </div>
    <div class="footer-bottom">
      <p>Originating in Territory Kidney Care.</p>
      <span>Open knowledge. Shared definitions.</span>
    </div>
    <div class="source-links"><a href="https://github.com/asaabey/picorules-docs">Documentation source ↗</a><a href="https://github.com/asaabey/picorules-studio">Studio source ↗</a></div>
  </footer>

  <!-- Preserve existing hash links if this site later replaces the original. -->
  <script define:vars={{ docIds: docs.map((doc) => doc.id) }}>
    function resolveLegacyDoc() {
      const hash = window.location.hash;
      const id = hash.replace(/^#\/?(?:doc-)?/, '');
      if (docIds.includes(id)) window.location.replace(`/docs/${id}/`);
    }
    resolveLegacyDoc();
    window.addEventListener('hashchange', resolveLegacyDoc);
  </script>
</SiteLayout>

<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; min-height: 112px; border-bottom: 1px solid var(--line); }
  nav { display: flex; align-items: center; gap: 2.4rem; }
  nav a { color: var(--text); font-size: .8rem; text-decoration: none; padding-block: .6rem; }
  nav a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; }
  .nav-studio { display: inline-flex; align-items: center; gap: .6rem; }
  .nav-docs-short { display: none; }
  .hero { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 3.5rem; align-items: center; padding-block: 105px 98px; }
  .hero-eyebrow { display: flex; align-items: center; gap: .7rem; margin-bottom: 2rem; color: var(--muted); }
  .hero-eyebrow span { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
  h1 { font-size: clamp(3.5rem, 5.75vw, 5.75rem); line-height: 1.04; letter-spacing: -.055em; }
  h1 em { display: block; margin-top: .08em; }
  .hero-description { font-size: .98rem; line-height: 1.9; max-width: 445px; margin-top: 1.8rem; color: var(--muted); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.6rem; margin-top: 2.2rem; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.6rem; padding: 1rem 1.25rem; color: var(--paper); background: var(--ink); font-size: .79rem; text-decoration: none; border: 1px solid var(--ink); transition: background 180ms ease, color 180ms ease; }
  .button:hover { color: var(--ink); background: transparent; }
  .quiet-link { display: inline-flex; align-items: center; gap: .8rem; font-size: .77rem; color: var(--muted); text-decoration: none; padding-block: .6rem; }
  .quiet-link:hover { color: var(--ink); }
  .hero-note { margin-top: 1.6rem; font-size: .67rem; color: var(--muted); }
  .hero-figure { padding-left: .5rem; }
  .intro-line { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.4rem; border-block: 1px solid var(--line); }
  .intro-line .eyebrow { font-size: .61rem; color: var(--muted); }
  .intro-line p { font-family: var(--serif); font-size: 1.05rem; font-style: italic; }
  .approach { display: grid; grid-template-columns: 1fr 1.05fr; gap: 8rem; padding-block: 112px 120px; }
  .section-introduction > .eyebrow, .platforms-introduction .eyebrow { color: var(--accent); margin-bottom: 1.6rem; }
  h2 { font-size: clamp(2.5rem, 3.65vw, 3.6rem); line-height: 1.08; letter-spacing: -.035em; }
  .section-introduction > p:not(.eyebrow) { margin-top: 1.4rem; font-size: .87rem; line-height: 1.9; color: var(--muted); max-width: 400px; }
  .section-introduction .text-link { margin-top: 1.65rem; }
  .approach-steps { margin: 0; padding: .2rem 0 0; list-style: none; }
  .approach-steps li { display: grid; grid-template-columns: 2rem 1fr; gap: 1.1rem; padding-block: 1.9rem; border-top: 1px solid var(--line); }
  .approach-steps li:first-child { padding-top: 1.6rem; }
  .step-number { color: var(--accent); font-family: var(--serif); font-style: italic; font-size: 1.05rem; padding-top: .3rem; }
  .approach-steps h3 { font-size: 1.85rem; letter-spacing: -.025em; line-height: 1.2; }
  .approach-steps p { margin-top: .7rem; font-size: .82rem; line-height: 1.9; color: var(--muted); max-width: 380px; }
  .platforms { background: var(--panel); padding-block: 88px 95px; }
  .platforms-introduction { display: grid; grid-template-columns: 1fr 1.05fr; gap: 8rem; align-items: end; }
  .platforms-introduction > p { font-size: .87rem; line-height: 1.9; color: var(--muted); max-width: 390px; padding-bottom: .3rem; }
  .platform-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3.5rem; margin-top: 3.8rem; }
  .platform { display: block; text-decoration: none; border-top: 1px solid var(--panel-line); padding-top: 1.6rem; }
  .platform-name { display: flex; align-items: center; justify-content: space-between; }
  .platform-name h3 { font-size: 2.4rem; letter-spacing: -.04em; }
  .platform-name svg { transition: transform 180ms ease; }
  .platform:hover .platform-name svg { transform: translate(2px, -2px); }
  .platform .eyebrow { font-size: .59rem; margin-top: .5rem; color: var(--muted); }
  .platform-description { font-size: .8rem; line-height: 1.85; margin-top: 1.2rem; max-width: 285px; color: var(--muted); }
  .sdk { display: grid; grid-template-columns: 1fr 1.05fr; gap: 8rem; padding-top: 100px; }
  .sdk-packages { min-width: 0; }
  .compiler-package { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .compiler-package > .eyebrow, .supporting-packages > .eyebrow { color: var(--muted); font-size: .6rem; }
  .compiler-name { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.1rem; color: var(--ink); text-decoration: none; }
  .compiler-name code { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-size: 1.02rem; overflow-wrap: anywhere; line-height: 1.6; }
  .compiler-name:hover code { text-decoration: underline; text-underline-offset: 4px; }
  .compiler-description { color: var(--muted); font-size: .82rem; line-height: 1.9; margin-top: .9rem; }
  .install-command { margin: 1.25rem 0 0; padding: 1rem 1.1rem; background: var(--surface); border-left: 2px solid var(--illustration); white-space: pre-wrap; overflow-wrap: anywhere; user-select: all; }
  .install-command code { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-size: .73rem; line-height: 1.7; }
  .compiler-links { display: flex; gap: 1.6rem; flex-wrap: wrap; margin-top: .8rem; }
  .compiler-links .text-link { font-size: .75rem; border-bottom: 0; }
  .compiler-links .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .supporting-packages { margin-top: 1.6rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .supporting-packages ul { display: flex; flex-wrap: wrap; gap: .2rem 1.5rem; list-style: none; margin: .6rem 0 0; padding: 0; }
  .supporting-packages a { display: inline-flex; align-items: center; gap: .5rem; font-size: .73rem; line-height: 1.6; padding-block: .55rem; text-decoration: none; }
  .supporting-packages a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .supporting-packages svg { width: 14px; height: 14px; }
  .invitation { background: #233e35; color: #f6f4ed; margin-block: 100px 0; padding: 64px 66px; display: grid; grid-template-columns: 1.8fr 1fr; gap: 3rem; }
  .invitation .eyebrow { color: #c9cdb5; margin-bottom: 1.6rem; }
  .invitation h2 { color: #f6f4ed; font-size: clamp(2.4rem, 3.8vw, 3.6rem); }
  .invitation-copy > p:not(.eyebrow) { font-size: .82rem; color: #d0d6c9; line-height: 1.8; margin-top: 1.3rem; max-width: 380px; }
  .invitation-actions { display: flex; gap: 1.8rem; align-items: center; flex-wrap: wrap; margin-top: 1.9rem; }
  .button-light { color: #233e35; background: #f6f4ed; border-color: #f6f4ed; }
  .button-light:hover { color: #f6f4ed; }
  .invitation .text-link { font-size: .76rem; }
  .invitation :focus-visible { outline-color: #f6f4ed; }
  .invitation-aside { align-self: center; justify-self: end; padding-right: 1rem; }
  .aside-rule { display: block; width: 36px; border-top: 1px solid #aebca4; margin-bottom: 1.5rem; }
  .invitation-aside p { font-family: var(--serif); font-style: italic; font-size: 1.5rem; line-height: 1.5; color: #d3ddc8; }
  .site-footer { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 2rem; padding-block: 64px 30px; }
  .site-footer > div:first-child > p { margin-top: .9rem; color: var(--muted); font-size: .7rem; }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a { display: inline-flex; align-items: center; gap: .35rem; font-size: .73rem; text-decoration: none; padding-block: .5rem; }
  .footer-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer-links svg { width: 14px; height: 14px; }
  .footer-bottom { grid-column: 1 / -1; margin-top: 3.2rem; padding-top: 1.3rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 1rem; font-size: .64rem; color: var(--muted); }
  .integration-notes { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--panel-line); }
  .integration-notes summary, .evidence summary { cursor: pointer; font-size: .77rem; padding-block: .75rem; }
  .integration-details { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 3.5rem; margin-top: 1.2rem; }
  .integration-details h3 { font-size: 1.6rem; }
  .integration-details p { margin-top: .8rem; font-size: .8rem; line-height: 1.85; color: var(--muted); }
  .integration-details a { display: inline-block; margin-top: .8rem; padding-block: .4rem; font-size: .73rem; text-decoration: none; }
  .integration-details a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .origins { display: grid; grid-template-columns: 1fr 1.05fr; gap: 8rem; border-block: 1px solid var(--line); padding-block: 60px; }
  .origins .eyebrow { color: var(--accent); margin-bottom: 1.6rem; }
  .origins-description > p, .evidence p { font-size: .84rem; line-height: 1.9; color: var(--muted); }
  .evidence { margin-top: 1rem; }
  .evidence p { font-size: .78rem; margin-top: .5rem; }
  .evidence ul { padding-left: 1rem; font-size: .73rem; line-height: 2.2; }
  .origins-description .text-link { margin-top: 1.25rem; font-size: .75rem; }
  .origins-links { display: flex; flex-wrap: wrap; gap: 0 1.6rem; }
  .source-links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: .62rem; color: var(--muted); margin-top: .8rem; }
  .source-links a { text-decoration: none; padding-block: .35rem; }
  .source-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 1500px) { .hero { gap: 4rem; } h1 { font-size: 5.4rem; } }
  @media (max-width: 1100px) {
    .hero { gap: 2.5rem; padding-block: 80px; grid-template-columns: 1.5fr 1fr; }
    h1 { font-size: clamp(3.5rem, 5.55vw, 5rem); }
    .approach, .platforms-introduction, .sdk, .origins { gap: 4rem; }
    .hero-actions { gap: 1rem; }
    .quiet-link { font-size: .7rem; }
    .invitation { padding: 52px 46px; }
  }
  @media (max-width: 800px) {
    .site-header { min-height: 96px; }
    nav { gap: 1.25rem; }
    .approach-link { display: none; }
    .hero { grid-template-columns: 1fr; gap: 2.5rem; padding-block: 65px 50px; }
    h1 { font-size: clamp(3.5rem, 8vw, 5.6rem); }
    .hero-description { max-width: 480px; }
    .hero-figure { max-width: 420px; width: 100%; padding-left: 0; justify-self: center; }
    .intro-line { align-items: start; }
    .intro-line p { text-align: right; }
    .approach { gap: 3rem; padding-block: 80px; }
    .approach-steps h3 { font-size: 1.65rem; }
    .platforms { padding-block: 70px; }
    .platforms-introduction { gap: 3rem; }
    .platform-list { gap: 1.8rem; }
    .sdk { gap: 3rem; padding-top: 70px; }
    .compiler-name code { font-size: .86rem; }
    .supporting-packages ul { gap: .2rem 1rem; }
    .invitation { margin-top: 70px; grid-template-columns: 1fr; padding: 46px 36px; }
    .invitation-aside { display: none; }
    .site-footer { grid-template-columns: 1fr; gap: 1.8rem; }
    .footer-bottom { margin-top: 1rem; }
    .origins { gap: 3rem; }
    .integration-details { gap: 1.8rem; }
    .footer-links { gap: 1.25rem; flex-wrap: wrap; }
  }
  @media (max-width: 600px) {
    .site-header { min-height: 84px; }
    nav { gap: .7rem; }
    .nav-docs-full { display: none; }
    .nav-docs-short { display: inline; }
