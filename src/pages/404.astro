---
import SiteLayout from '../layouts/SiteLayout.astro';
import Wordmark from '../components/Wordmark.astro';
---

<SiteLayout title="Page not found — Picorules">
  <main id="main" class="shell" style="padding-block: 4rem;">
    <Wordmark />
    <p class="eyebrow" style="margin-top: 5rem;">Page not found</p>
    <h1 style="font-size: clamp(3rem, 6vw, 5rem); margin-top: 1rem;">A different path.</h1>
    <p style="margin-top: 1.5rem; line-height: 1.8;">This page does not exist. <a href="/">Return to Picorules</a> or <a href="/docs/introduction/">explore the documentation</a>.</p>
  </main>
</SiteLayout>
